---
import fs from 'node:fs';
import path from 'node:path';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroDex, { type Entry } from '../components/HeroDex';
import Contents, { type Part } from '../components/Contents';
import DexRecord from '../components/DexRecord';
import MovedRow from '../components/MovedRow';
import FriendColor from '../components/FriendColor';
import { APP, REPO, RA, RA_KEYS } from '../lib/site';
import consoles from '../lib/consoles.json';
import '../styles/home.css';

import dDex from '../assets/shots/d-dex.png';
import dex from '../assets/shots/dex.png';
import dGame from '../assets/shots/d-game.png';
import game from '../assets/shots/game.png';
import dActivity from '../assets/shots/d-activity.png';
import activity from '../assets/shots/activity.png';
import backlog from '../assets/shots/backlog.png';
import dStats from '../assets/shots/d-stats.png';
import overview from '../assets/shots/overview.png';
import login from '../assets/shots/login.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const icon = (no: number) => base + 'icons/' + no + '.png';
const files = (dir: string) => fs.readdirSync(path.join(process.cwd(), 'public', dir)).filter(f => f.endsWith('.png')).sort();

// The hero wall: every game icon in the author's dex, with their badges mixed in (Backloggd's cover wall, our way)
const gamesIcons = files('wall').map(f => base + 'wall/' + f);
const badgeIcons = files('badges').map(f => base + 'badges/' + f);
const wallTiles = gamesIcons.flatMap((g, k) => [g, badgeIcons[k % badgeIcons.length]]);
const wallRows = [0, 1, 2, 3, 4].map(r => wallTiles.filter((_, k) => k % 5 === r));

const entries: Entry[] = [
    { no: 16244, title: 'Final Fantasy Crystal Chronicles: Ring of Fates', console: 'Nintendo DS', icon: icon(16244), got: 9, total: 76, state: 'played', path: [7, 22] },
    { no: 11306, title: 'Tomba! 2: The Evil Swine Return', console: 'PlayStation', icon: icon(11306), got: 30, total: 45, state: 'beaten' },
    { no: 2873, title: "Donald Duck: Goin' Quackers", console: 'PlayStation', icon: icon(2873), got: 46, total: 65, state: 'beaten' },
    { no: 16452, title: '7th Dragon 2020', console: 'PlayStation Portable', icon: icon(16452), got: 80, total: 80, state: 'mastered' },
];
const moved = [
    { no: 16244, title: 'Final Fantasy Crystal Chronicles: Ring of Fates', console: 'Nintendo DS', icon: icon(16244), before: 0, now: 9, total: 76 },
    { no: 45053, title: 'Poring Clicker', console: 'Standalone', icon: icon(45053), before: 0, now: 61, total: 156 },
];

const web = async (img: ImageMetadata, width: number) => (await getImage({ src: img, width, format: 'webp' })).src;
const parts: Part[] = [
    { id: 'dex', name: 'The Dex', holds: 'every game, numbered', text: 'Every game you have played, numbered by its RetroAchievements ID. Filter to unbeaten, beaten or mastered, or read it console by console.',
      desk: { src: await web(dDex, 1440), alt: 'The Dex on desktop: game entries in number order beside the profile rail' }, phone: { src: await web(dex, 390), alt: 'The Dex on a phone' } },
    { id: 'record', name: 'Dex records', holds: 'one page per game', text: 'Each game opens as its dex record: the completion ring, achievements and points as index lines, and the progression path.',
      desk: { src: await web(dGame, 1440), alt: 'A game page on desktop with its dex record and achievement list' }, phone: { src: await web(game, 390), alt: 'A game page on a phone' } },
    { id: 'activity', name: 'Activity', holds: 'runs, day by day', text: 'The dexes that moved in the last fortnight, then every run of unlocks, day by day, with a year of streaks and a heatmap.',
      desk: { src: await web(dActivity, 1440), alt: 'Activity on desktop: the dexes that moved, the year and recent runs' }, phone: { src: await web(activity, 390), alt: 'Activity on a phone' } },
    { id: 'backlog', name: 'Backlog', holds: 'your want-to-play list', text: 'Your RetroAchievements want-to-play list as a watchlist, subsets stacked under their game, progress as rings.',
      phone: { src: await web(backlog, 390), alt: 'The backlog watchlist on a phone' } },
    { id: 'stats', name: 'Stats', holds: 'a year in charts', text: 'Streaks and pace as index lines, points across the year, masteries by month, consoles and how rare your unlocks are.',
      desk: { src: await web(dStats, 1440), alt: 'Stats on desktop: streaks, point acquisition, masteries, consoles and rarity' } },
    { id: 'overview', name: 'Overview', holds: 'the profile at a glance', text: 'Last played, recent unlocks, your stats and every award, with the latest mastery on top.',
      phone: { src: await web(overview, 390), alt: 'The profile overview on a phone' } },
];

const description = 'Cheevodex is a free, open-source companion for RetroAchievements: every game you have played as a numbered dex entry, with completion rings, activity, friends and your backlog. Runs in your browser; your API key never leaves it.';
const jsonLd = [{
    '@type': 'WebApplication',
    name: 'Cheevodex',
    description,
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Achievement tracker',
    operatingSystem: 'Web, Android, iOS (installable web app)',
    browserRequirements: 'Requires JavaScript',
    url: APP,
    image: new URL(base + 'assets/og.jpg', Astro.site).href,
    screenshot: new URL(await web(dDex, 1440), Astro.site).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    sameAs: [REPO],
    featureList: ['Every played game as a numbered dex entry', 'Completion rings and progression paths', 'Activity with streaks and a heatmap', 'Friends timeline', 'Backlog watchlist', 'Installs as a phone app'],
}];
---
<Base title="Cheevodex: a pocket companion for RetroAchievements" {description} {jsonLd}>
<main id="main">

    <!-- Hero: a wall of the author's games and badges, the copy, and a dex entry writing itself -->
    <section class="hero">
        <div class="wall" aria-hidden="true">
            {wallRows.map((r, k) => (
                <div class={`wrow w${k}`}>{[...r, ...r].map(src => <img src={src} alt="" width="72" height="72" loading="lazy" />)}</div>
            ))}
        </div>
        <div class="wrap hero-grid">
            <div class="hero-copy">
                <h1>Every unlock, in your own dex.</h1>
                <p class="lede">Cheevodex turns your RetroAchievements account into a dex: every game you have played, numbered, ringed and ready on your phone.</p>
                <div class="cta">
                    <a class="btn btn-primary" href={APP}>Open Cheevodex</a>
                    <a class="btn btn-ghost" href="#setup">How to connect</a>
                </div>
                <dl class="hero-facts">
                    <div><dt>Consoles</dt><dd>{consoles.length}</dd></div>
                    <div><dt>Price</dt><dd>Free</dd></div>
                    <div><dt>Licence</dt><dd>MIT</dd></div>
                </dl>
            </div>
            <div class="hero-stage">
                <HeroDex client:visible entries={entries} />
            </div>
        </div>
    </section>

    <!-- Every system RetroAchievements covers, as a ticker -->
    <div class="ticker" role="img" aria-label={`Works with the ${consoles.length} systems RetroAchievements supports`}>
        <div class="ticker-track" aria-hidden="true">
            {[...consoles, ...consoles].map(c => <span>{c}</span>)}
        </div>
    </div>

    <!-- The Dex. (blue band) -->
    <section class="band b-blue" id="dex">
        <div class="wrap split">
            <div class="split-copy reveal">
                <h2>The Dex.</h2>
                <p class="big">Every game you have touched on RetroAchievements gets an entry and a number: its RA game ID.</p>
                <p>Search it by name or number. Filter to what you have not beaten yet. Read it console by console. Is it a list? Technically. It is a dex.</p>
                <dl class="dexcount">
                    <div><dt>Played</dt><dd>96</dd></div>
                    <div><dt>Beaten</dt><dd>8</dd></div>
                    <div><dt>Mastered</dt><dd>2</dd></div>
                </dl>
                <p class="caption">The author's dex, as Cheevodex shows it.</p>
            </div>
            <div class="split-shot reveal">
                <Image class="shot phone-shot" src={dex} alt="The Dex on a phone: numbered entries with their icons, counts and state" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 340px" />
            </div>
        </div>
    </section>

    <!-- The Record. (charcoal band) -->
    <section class="band b-coal" id="record">
        <div class="wrap split flip">
            <div class="split-copy reveal">
                <h2>The Record.</h2>
                <p class="big">Each game opens as a dex record: a ring for how far you are, index lines for the numbers.</p>
                <p>And a path with one diamond for every progression achievement. Light them all and the game is beaten. Watch it light up.</p>
            </div>
            <div class="split-shot reveal">
                <DexRecord client:visible icon={icon(16244)} />
            </div>
        </div>
    </section>

    <!-- The Fortnight. (gold band) -->
    <section class="band b-gold" id="fortnight">
        <div class="wrap split">
            <div class="split-copy reveal">
                <h2>The Fortnight.</h2>
                <p class="big">Activity opens on the dexes that moved: what you had before, dim; what you gained, bright.</p>
                <p>Then every run of unlocks, day by day, a year of streaks, and the heatmap. Mostly so you can see how much Poring Clicker you played.</p>
            </div>
            <div class="split-shot reveal moved-stage">
                <MovedRow client:visible rows={moved} />
                <Image class="shot phone-shot mini" src={activity} alt="Activity on a phone: the dexes that moved, then the day's runs" widths={[390, 780]} sizes="(max-width: 960px) 50vw, 240px" />
            </div>
        </div>
    </section>

    <!-- The Friends. (charcoal band, interactive) -->
    <section class="band b-coal" id="friends">
        <div class="wrap split flip">
            <div class="split-copy reveal">
                <h2>The Friends.</h2>
                <p class="big">Everyone you follow on one timeline, newest first, each in a colour worked out from their name.</p>
                <p>Not picked at random, not saved anywhere: the same name always gets the same colour. Try yours.</p>
            </div>
            <div class="split-shot reveal">
                <FriendColor client:visible />
            </div>
        </div>
    </section>

    <!-- The Contents. -->
    <section class="band b-ink" id="contents">
        <div class="wrap">
            <div class="section-head reveal">
                <h2>The Contents.</h2>
                <p class="big">Six parts, one tap apart. Pick a line to turn to it.</p>
            </div>
            <div class="reveal"><Contents client:visible parts={parts} /></div>
        </div>
    </section>

    <!-- The Key. (deep blue band) -->
    <section class="band b-deep" id="key">
        <div class="wrap split">
            <div class="split-copy reveal">
                <h2>The Key.</h2>
                <p class="big">Cheevodex has no server and no account of its own.</p>
                <p>It asks RetroAchievements directly from your browser with your web API key, and the key stays on your device. The code is on <a href={REPO}>GitHub</a> if you would like to check.</p>
            </div>
            <figure class="flow reveal" aria-label="Your browser talks to the RetroAchievements API directly">
                <div class="node"><b>Your browser</b><span>Cheevodex, with your key saved on this device</span></div>
                <div class="wire"><span>direct, over HTTPS</span></div>
                <div class="node"><b>RetroAchievements</b><span>its public web API</span></div>
                <figcaption>Nothing in between.</figcaption>
            </figure>
        </div>
    </section>

    <!-- The Setup. -->
    <section class="band b-coal" id="setup">
        <div class="wrap split flip">
            <div class="split-copy reveal">
                <h2>The Setup.</h2>
                <ol class="steps">
                    <li><span>Log in at <a href={RA}>retroachievements.org</a>.</span></li>
                    <li><span>Open <a href={RA_KEYS}>Settings</a>, then Keys, and copy your web API key.</span></li>
                    <li><span>Open Cheevodex and enter your username and the key.</span></li>
                </ol>
                <p>That is the whole setup. Install it from your browser's menu and it opens full screen, like an app.</p>
                <div class="cta"><a class="btn btn-primary" href={APP}>Open Cheevodex</a></div>
            </div>
            <div class="split-shot reveal">
                <Image class="shot phone-shot" src={login} alt="The Cheevodex sign-in: RA username, API key and how to find the key" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 340px" />
            </div>
        </div>
    </section>

    <!-- The close, in Analogue's register -->
    <section class="close">
        <div class="wrap">
            <p class="close-line reveal">For everyone still chasing the last achievement in a game older than they are.</p>
            <a class="btn btn-primary reveal" href={APP}>Open your dex</a>
        </div>
    </section>
</main>
</Base>
