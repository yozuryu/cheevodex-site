---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroDex, { type Entry } from '../components/HeroDex';
import Contents, { type Part } from '../components/Contents';
import DexRecord from '../components/DexRecord';
import MovedRow from '../components/MovedRow';
import FriendColor from '../components/FriendColor';
import { APP, REPO, RA, RA_KEYS } from '../lib/site';
import consoles from '../lib/consoles.json';
import '../styles/home.css';

import dDex from '../assets/shots/d-dex.png';
import dex from '../assets/shots/dex.png';
import dGame from '../assets/shots/d-game.png';
import game from '../assets/shots/game.png';
import dActivity from '../assets/shots/d-activity.png';
import activity from '../assets/shots/activity.png';
import backlog from '../assets/shots/backlog.png';
import dStats from '../assets/shots/d-stats.png';
import overview from '../assets/shots/overview.png';
import login from '../assets/shots/login.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');


const entries: Entry[] = [
    { no: 16244, title: 'Final Fantasy Crystal Chronicles: Ring of Fates', console: 'Nintendo DS', got: 9, total: 76, state: 'played', path: [7, 22] },
    { no: 11306, title: 'Tomba! 2: The Evil Swine Return', console: 'PlayStation', got: 30, total: 45, state: 'beaten' },
    { no: 2873, title: "Donald Duck: Goin' Quackers", console: 'PlayStation', got: 46, total: 65, state: 'beaten' },
    { no: 16452, title: '7th Dragon 2020', console: 'PlayStation Portable', got: 80, total: 80, state: 'mastered' },
];
const moved = [
    { no: 16244, title: 'Final Fantasy Crystal Chronicles: Ring of Fates', console: 'Nintendo DS', before: 0, now: 9, total: 76 },
    { no: 45053, title: 'Poring Clicker', console: 'Standalone', before: 0, now: 61, total: 156 },
];

const web = async (img: ImageMetadata, width: number) => (await getImage({ src: img, width, format: 'webp' })).src;
const parts: Part[] = [
    { id: 'dex', name: 'The Dex', holds: 'every game, numbered', text: 'Every game you have played, numbered by its RetroAchievements ID. Filter to unbeaten, beaten or mastered, or read it console by console.',
      desk: { src: await web(dDex, 1440), alt: 'The Dex on desktop: game entries in number order beside the profile rail' }, phone: { src: await web(dex, 390), alt: 'The Dex on a phone' } },
    { id: 'record', name: 'Dex records', holds: 'one page per game', text: 'Each game opens as its dex record: the completion ring, achievements and points as index lines, and the progression path.',
      desk: { src: await web(dGame, 1440), alt: 'A game page on desktop with its dex record and achievement list' }, phone: { src: await web(game, 390), alt: 'A game page on a phone' } },
    { id: 'activity', name: 'Activity', holds: 'runs, day by day', text: 'The dexes that moved in the last fortnight, then every run of unlocks, day by day, with a year of streaks and a heatmap.',
      desk: { src: await web(dActivity, 1440), alt: 'Activity on desktop: the dexes that moved, the year and recent runs' }, phone: { src: await web(activity, 390), alt: 'Activity on a phone' } },
    { id: 'backlog', name: 'Backlog', holds: 'your want-to-play list', text: 'Your RetroAchievements want-to-play list as a watchlist, subsets stacked under their game, progress as rings.',
      phone: { src: await web(backlog, 390), alt: 'The backlog watchlist on a phone' } },
    { id: 'stats', name: 'Stats', holds: 'a year in charts', text: 'Streaks and pace as index lines, points across the year, masteries by month, consoles and how rare your unlocks are.',
      desk: { src: await web(dStats, 1440), alt: 'Stats on desktop: streaks, point acquisition, masteries, consoles and rarity' } },
    { id: 'overview', name: 'Overview', holds: 'the profile at a glance', text: 'Last played, recent unlocks, your stats and every award, with the latest mastery on top.',
      phone: { src: await web(overview, 390), alt: 'The profile overview on a phone' } },
];

const description = 'Cheevodex is a free, open-source companion for RetroAchievements: every game you have played as a numbered dex entry, with completion rings, activity, friends and your backlog. Runs in your browser; your API key never leaves it.';
const jsonLd = [{
    '@type': 'WebApplication',
    name: 'Cheevodex',
    description,
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Achievement tracker',
    operatingSystem: 'Web, Android, iOS (installable web app)',
    browserRequirements: 'Requires JavaScript',
    url: APP,
    image: new URL(base + 'assets/og.jpg', Astro.site).href,
    screenshot: new URL(await web(dDex, 1440), Astro.site).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    sameAs: [REPO],
    featureList: ['Every played game as a numbered dex entry', 'Completion rings and progression paths', 'Activity with streaks and a heatmap', 'Friends timeline', 'Backlog watchlist', 'Installs as a phone app'],
}];
---
<Base title="Cheevodex: a pocket companion for RetroAchievements" {description} {jsonLd}>
<main id="main">

    <!-- Hero: the headline across the top; under it three real phone screens fanned like a hand of cards, a dex entry writing itself in front -->
    <section class="hero">
        <div class="wrap">
            <div class="hero-head">
                <h1>Every unlock,<br> in your own dex.</h1>
                <p class="lede">Cheevodex turns your RetroAchievements account into a dex: every game you have played, numbered, ringed and ready on your phone.</p>
                <div class="cta">
                    <a class="btn btn-primary" href={APP}>Open Cheevodex</a>
                    <a class="btn btn-ghost" href="#setup">How to connect</a>
                </div>
            </div>
            <div class="fan" aria-label="Cheevodex on a phone: the Dex, a game's dex record and Activity">
                <Image class="fan-card f-l" src={dex} alt="The Dex on a phone: numbered entries with counts and state" widths={[390, 780]} sizes="(max-width: 700px) 46vw, 300px" loading="eager" />
                <Image class="fan-card f-c" src={game} alt="A game's dex record on a phone: ring, index lines and progression path" widths={[390, 780]} sizes="(max-width: 700px) 50vw, 320px" loading="eager" fetchpriority="high" />
                <Image class="fan-card f-r" src={activity} alt="Activity on a phone: the dexes that moved, then the day's runs" widths={[390, 780]} sizes="(max-width: 700px) 46vw, 300px" loading="eager" />
                <div class="fan-entry"><HeroDex client:visible entries={entries} /></div>
            </div>
            <dl class="hero-facts">
                <div><dt>Consoles</dt><dd>{consoles.length}</dd></div>
                <div><dt>Price</dt><dd>Free</dd></div>
                <div><dt>Licence</dt><dd>MIT</dd></div>
                <div><dt>Sign-up</dt><dd>None</dd></div>
            </dl>
        </div>
    </section>

    <!-- The Dex: the heading at full size over the desktop screen, the counts set into it -->
    <section class="band b-blue" id="dex">
        <div class="wrap">
            <div class="head-row reveal">
                <h2>The Dex.</h2>
                <p class="big">Every game you have touched on RetroAchievements gets an entry and a number: its RA game ID. Is it a list? Technically. It is a dex.</p>
            </div>
            <figure class="screen reveal">
                <Image class="shot screen-shot" src={dDex} alt="The Dex on desktop: every played game as a numbered entry beside the profile rail" widths={[900, 1400, 2000]} sizes="(max-width: 1180px) 94vw, 1116px" />
                <dl class="screen-panel">
                    <div><dt>Played</dt><dd>96</dd></div>
                    <div><dt>Beaten</dt><dd>8</dd></div>
                    <div><dt>Mastered</dt><dd>2</dd></div>
                    <figcaption>The author's dex. Search by name or number, filter to what is not beaten yet, or sort by console.</figcaption>
                </dl>
            </figure>
        </div>
    </section>

    <!-- The Record: a manual page, the live record in the middle with its parts called out -->
    <section class="band b-coal" id="record">
        <div class="wrap">
            <div class="head-center reveal">
                <h2>The Record.</h2>
                <p class="big">Each game opens as a dex record. Here is how to read one.</p>
            </div>
            <div class="manual reveal">
                <ol class="callouts left">
                    <li><b>The ring.</b> How far you are. It turns gold and glows when the game is mastered.</li>
                    <li><b>The numbers.</b> Achievements, points and time played, as index lines.</li>
                </ol>
                <div class="manual-card"><DexRecord client:visible /></div>
                <ol class="callouts right" start="3">
                    <li><b>The path.</b> One diamond per progression achievement. Light them all and the game is beaten.</li>
                    <li><b>The number.</b> Dex No.16244 is its RetroAchievements game ID.</li>
                </ol>
            </div>
        </div>
    </section>

    <!-- The Fortnight: the two-tone ring at poster size, the moved rows playing beside it -->
    <section class="band b-gold" id="fortnight">
        <div class="wrap fortnight">
            <div class="poster-ring reveal" role="img" aria-label="A ring: the part you already had, dim, and the part you gained this fortnight, bright">
                <span class="ring two big" style="--b:38;--p:62;--c:var(--accent)"></span>
                <span class="pr-legend"><span class="dim"><i></i>what you had</span><span class="new"><i></i>what you gained</span></span>
            </div>
            <div class="fortnight-copy reveal">
                <h2>The Fortnight.</h2>
                <p class="big">Activity opens on the dexes that moved: what you had before, dim; what you gained, bright.</p>
                <MovedRow client:visible rows={moved} />
                <p>Then every run of unlocks, day by day, a year of streaks, and the heatmap. Mostly so you can see how much Poring Clicker you played.</p>
            </div>
        </div>
    </section>

    <!-- The Friends: a full-width instrument -->
    <section class="band b-coal" id="friends">
        <div class="wrap">
            <div class="head-row reveal">
                <h2>The Friends.</h2>
                <p class="big">Everyone you follow on one timeline, each in a colour worked out from their name. Not random, not saved: the same name always gets the same colour.</p>
            </div>
            <div class="reveal"><FriendColor client:visible /></div>
        </div>
    </section>

    <!-- The Contents: a contents page across the spread -->
    <section class="band b-ink" id="contents">
        <div class="wrap">
            <div class="head-row reveal">
                <h2>The Contents.</h2>
                <p class="big">Six parts, one tap apart. Pick a line to turn to it.</p>
            </div>
            <div class="reveal"><Contents client:visible parts={parts} /></div>
        </div>
    </section>

    <!-- The Key: the whole journey of a request, drawn across the page -->
    <section class="band b-deep" id="key">
        <div class="wrap">
            <div class="head-center reveal">
                <h2>The Key.</h2>
                <p class="big">No server, no account of its own. Your key stays on your device.</p>
            </div>
            <figure class="wireline reveal" aria-label="Your browser talks to the RetroAchievements API directly, with nothing in between">
                <div class="wl-node"><b>Your browser</b><span>Cheevodex, and your web API key saved on this device</span></div>
                <div class="wl-wire"><span>direct, over HTTPS</span></div>
                <div class="wl-node"><b>RetroAchievements</b><span>its public web API</span></div>
            </figure>
            <p class="key-note reveal">Nothing in between. The code is on <a href={REPO}>GitHub</a> if you would like to check.</p>
        </div>
    </section>

    <!-- The Setup: three steps on a progression path that ends at the app -->
    <section class="band b-coal" id="setup">
        <div class="wrap">
            <div class="head-center reveal">
                <h2>The Setup.</h2>
                <p class="big">Three steps. Light them all and your dex opens.</p>
            </div>
            <ol class="setup-path reveal">
                <li><i aria-hidden="true"></i><b>Log in</b><span>at <a href={RA}>retroachievements.org</a></span></li>
                <li><i aria-hidden="true"></i><b>Copy your key</b><span>from <a href={RA_KEYS}>Settings</a>, then Keys</span></li>
                <li><i aria-hidden="true"></i><b>Connect</b><span>your username and the key in Cheevodex</span></li>
                <li class="goal"><i aria-hidden="true"></i><a class="btn btn-primary" href={APP}>Open Cheevodex</a><span>Install it from your browser's menu and it opens like an app.</span></li>
            </ol>
            <div class="setup-shot reveal">
                <Image class="shot phone-shot" src={login} alt="The Cheevodex sign-in: RA username, API key and how to find the key" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 320px" />
            </div>
        </div>
    </section>

    <!-- The close -->
    <section class="close">
        <div class="wrap">
            <p class="close-line reveal">For everyone still chasing the last achievement in a game older than they are.</p>
            <a class="btn btn-primary reveal" href={APP}>Open your dex</a>
        </div>
    </section>
</main>
</Base>
