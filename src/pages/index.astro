---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroB from '../components/heroes/HeroB.astro';
import RecordTour, { type Rec } from '../components/RecordTour';
import FriendsPreview, { type Post } from '../components/FriendsPreview';
import examples from '../lib/examples.json';
import Contents, { type Part } from '../components/Contents';
import MovedRow from '../components/MovedRow';
import { APP, REPO, RA, RA_KEYS } from '../lib/site';
import '../styles/home.css';

import dDex from '../assets/shots/d-dex.png';
import dex from '../assets/shots/dex.png';
import dGame from '../assets/shots/d-game.png';
import game from '../assets/shots/game.png';
import dActivity from '../assets/shots/d-activity.png';
import activity from '../assets/shots/activity.png';
import backlog from '../assets/shots/backlog.png';
import dStats from '../assets/shots/d-stats.png';
import overview from '../assets/shots/overview.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Game icons and the author's avatar, shown only inside previews of the app
const appIcon = (n: number | string) => base + 'app-icons/' + n + '.png';


// Example data on real RetroAchievements games (icons and badges from RA; the numbers are examples)
const ex = examples as Record<string, { no: number; title: string; console: string; icon: string; unlocks?: { title: string; badge: string; points: number; hc: boolean }[] }>;
const g = (k: string) => ({ no: ex[k].no, title: ex[k].title, console: ex[k].console, icon: appIcon(ex[k].icon.replace('.png', '')) });
const moved = [
    { ...g('trails'), before: 41, now: 52, total: 104 },
    { ...g('tekken3'), before: 5, now: 14, total: 40 },
    { ...g('spm'), before: 12, now: 19, total: 78 },
];
const records: Rec[] = [
    { state: 'played', ...g('ys7'), got: 34, total: 96, pts: 312, ptsTotal: 970, played: '18h 40m', path: [9, 24] },
    { state: 'beaten', ...g('kirby'), got: 41, total: 60, pts: 405, ptsTotal: 600, played: '9h 12m', path: [15, 15] },
    { state: 'mastered', ...g('oot'), got: 96, total: 96, pts: 815, ptsTotal: 815, played: '41h 5m', path: [30, 30] },
];
const unlocks = (k: string) => ex[k].unlocks!.map(u => ({ ...u, badge: base + 'app-icons/' + u.badge }));
const posts: Post[] = [
    { name: 'Yozuryu', time: '22:40', runs: [
        { ...g('windwaker'), time: '21:05–22:40', unlocks: unlocks('windwaker') },
        { ...g('fate'), time: '19:30–20:10', unlocks: unlocks('fate') } ] },
    { name: 'SaveStateSue', time: '18:12', runs: [
        { ...g('nfs2'), time: '17:20–18:12', unlocks: unlocks('nfs2') } ] },
];

const web = async (img: ImageMetadata, width: number) => (await getImage({ src: img, width, format: 'webp' })).src;
const parts: Part[] = [
    { id: 'dex', name: 'The Dex', holds: 'every game, numbered', text: 'Every game you have played, numbered by its RetroAchievements ID. Filter to unbeaten, beaten or mastered, or read it console by console.',
      desk: { src: await web(dDex, 1440), alt: 'The Dex on desktop: game entries in number order beside the profile rail' }, phone: { src: await web(dex, 390), alt: 'The Dex on a phone' } },
    { id: 'record', name: 'Dex records', holds: 'one page per game', text: 'Each game opens as its dex record: the completion ring, achievements and points as index lines, and the progression path.',
      desk: { src: await web(dGame, 1440), alt: 'A game page on desktop with its dex record and achievement list' }, phone: { src: await web(game, 390), alt: 'A game page on a phone' } },
    { id: 'activity', name: 'Activity', holds: 'runs, day by day', text: 'The dexes that moved in the last fortnight, then every run of unlocks, day by day, with a year of streaks and a heatmap.',
      desk: { src: await web(dActivity, 1440), alt: 'Activity on desktop: the dexes that moved, the year and recent runs' }, phone: { src: await web(activity, 390), alt: 'Activity on a phone' } },
    { id: 'backlog', name: 'Backlog', holds: 'your want-to-play list', text: 'Your RetroAchievements want-to-play list as a watchlist, subsets stacked under their game, progress as rings.',
      phone: { src: await web(backlog, 390), alt: 'The backlog watchlist on a phone' } },
    { id: 'stats', name: 'Stats', holds: 'a year in charts', text: 'Streaks and pace as index lines, points across the year, masteries by month, consoles and how rare your unlocks are.',
      desk: { src: await web(dStats, 1440), alt: 'Stats on desktop: streaks, point acquisition, masteries, consoles and rarity' } },
    { id: 'overview', name: 'Overview', holds: 'the profile at a glance', text: 'Last played, recent unlocks, your stats and every award, with the latest mastery on top.',
      phone: { src: await web(overview, 390), alt: 'The profile overview on a phone' } },
];

const description = 'Cheevodex is a free, open-source companion for RetroAchievements: every game you have played as a numbered dex entry, with completion rings, activity, friends and your backlog. Runs in your browser; your API key never leaves it.';
const jsonLd = [{
    '@type': 'WebApplication',
    name: 'Cheevodex',
    description,
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Achievement tracker',
    operatingSystem: 'Web, Android, iOS (installable web app)',
    browserRequirements: 'Requires JavaScript',
    url: APP,
    image: new URL(base + 'assets/og.jpg', Astro.site).href,
    screenshot: new URL(await web(dDex, 1440), Astro.site).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    sameAs: [REPO],
    featureList: ['Every played game as a numbered dex entry', 'Completion rings and progression paths', 'Activity with streaks and a heatmap', 'Friends timeline', 'Backlog watchlist', 'Installs as a phone app'],
}];
---
<Base title="Cheevodex: a pocket companion for RetroAchievements" {description} {jsonLd}>
<main id="main">

    <HeroB />

    <!-- The Dex: the heading at full size over the desktop screen, the counts set into it -->
    <section class="band b-blue" id="dex">
        <div class="wrap">
            <div class="head-row reveal">
                <h2>The Dex.</h2>
                <p class="big">Every game you have touched on RetroAchievements gets an entry and a number: its RA game ID. Is it a list? Technically. It is a dex.</p>
            </div>
            <figure class="screen reveal">
                <Image class="shot screen-shot" src={dDex} alt="The Dex on desktop: every played game as a numbered entry beside the profile rail" widths={[900, 1400, 2000]} sizes="(max-width: 1180px) 94vw, 1116px" />
                <dl class="screen-panel">
                    <div><dt>Played</dt><dd>96</dd></div>
                    <div><dt>Beaten</dt><dd>8</dd></div>
                    <div><dt>Mastered</dt><dd>2</dd></div>
                    <figcaption>The author's dex. Search by name or number, filter to what is not beaten yet, or sort by console.</figcaption>
                </dl>
            </figure>
        </div>
    </section>

    <!-- The Record: a manual page that tours its own parts -->
    <section class="band b-coal" id="record">
        <div class="wrap">
            <div class="head-center reveal">
                <h2>The Record.</h2>
                <p class="big">Each game opens as a dex record. Here is how to read one.</p>
            </div>
            <div class="reveal"><RecordTour client:visible records={records} /></div>
        </div>
    </section>

    <!-- The Recap: the dexes that moved, counting up, beside the real Activity screen -->
    <section class="band b-gold" id="recap">
        <div class="wrap recap">
            <div class="recap-copy reveal">
                <h2>The Recap.</h2>
                <p class="big">Activity opens on the games you moved in the last 14 days: where they were, where they are now.</p>
                <MovedRow client:visible rows={moved} />
                <p class="caption">Real games, example numbers.</p>
                <p>Then every run of unlocks, day by day, a year of streaks, and the heatmap. Mostly so you can see which game ate your fortnight.</p>
            </div>
            <div class="recap-shot reveal">
                <Image class="shot phone-shot" src={activity} alt="Activity on a phone: the games that moved in the last 14 days, then the day's runs" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 340px" />
            </div>
        </div>
    </section>

    <!-- The Friends: what the timeline shows, beside a working preview of it -->
    <section class="band b-coal" id="friends">
        <div class="wrap friends">
            <div class="friends-copy reveal">
                <h2>The Friends.</h2>
                <p class="big">Everyone you follow on RetroAchievements, on one timeline.</p>
                <dl class="ledger friends-list">
                    <div class="row"><dt>Who is active</dt><i></i><dd>a strip of faces, newest first</dd></div>
                    <div class="row"><dt>What they played</dt><i></i><dd>runs by day, game by game</dd></div>
                    <div class="row"><dt>What they unlocked</dt><i></i><dd>the badges, then every row</dd></div>
                    <div class="row"><dt>Who is who</dt><i></i><dd>one colour per name, always</dd></div>
                </dl>
                <p>Tap a friend to see only their runs, or a game to open it beside your own progress. A friend's colour comes from their name, so it is the same on every device and never saved anywhere.</p>
            </div>
            <div class="reveal"><FriendsPreview client:visible posts={posts} avatar={appIcon('yozuryu')} /></div>
        </div>
    </section>

    <!-- The Contents: a contents page across the spread -->
    <section class="band b-ink" id="contents">
        <div class="wrap">
            <div class="head-row reveal">
                <h2>The Contents.</h2>
                <p class="big">Six parts, one tap apart. Pick a line to turn to it.</p>
            </div>
            <div class="reveal"><Contents client:visible parts={parts} /></div>
        </div>
    </section>

    <!-- The Setup: three steps on a progression path ending at the app, and where your key goes -->
    <section class="band b-deep" id="setup">
        <div class="wrap">
            <div class="head-center reveal">
                <h2>The Setup.</h2>
                <p class="big">Three steps. Light them all and your dex opens.</p>
            </div>
            <ol class="setup-path reveal">
                <li><i aria-hidden="true"></i><b>Log in</b><span>at <a href={RA}>retroachievements.org</a></span></li>
                <li><i aria-hidden="true"></i><b>Copy your key</b><span>from <a href={RA_KEYS}>Settings</a>, then Keys</span></li>
                <li><i aria-hidden="true"></i><b>Connect</b><span>your username and the key in Cheevodex</span></li>
                <li class="goal"><i aria-hidden="true"></i><a class="btn btn-primary" href={APP}>Open Cheevodex</a><span>Install it from your browser's menu and it opens like an app.</span></li>
            </ol>
            <figure class="keyline reveal" aria-label="Your browser talks to the RetroAchievements API directly, with nothing in between">
                <span class="kl-node">Your browser<small>your key stays here</small></span>
                <span class="kl-wire">direct, over HTTPS</span>
                <span class="kl-node">RetroAchievements<small>its public web API</small></span>
                <figcaption>Cheevodex has no server and no account of its own. The code is on <a href={REPO}>GitHub</a> if you would like to check.</figcaption>
            </figure>
        </div>
    </section>

    <!-- The close -->
    <section class="close">
        <div class="wrap">
            <p class="close-line reveal">For everyone still chasing the last achievement in a game older than they are.</p>
            <a class="btn btn-primary reveal" href={APP}>Open your dex</a>
        </div>
    </section>
</main>
</Base>
