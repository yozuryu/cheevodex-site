---
import fs from 'node:fs';
import path from 'node:path';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HeroDex, { type Entry } from '../components/HeroDex';
import Contents, { type Part } from '../components/Contents';
import DexRecord from '../components/DexRecord';
import { APP, REPO, RA, RA_KEYS } from '../lib/site';
import '../styles/home.css';

import dDex from '../assets/shots/d-dex.png';
import dex from '../assets/shots/dex.png';
import dGame from '../assets/shots/d-game.png';
import game from '../assets/shots/game.png';
import dActivity from '../assets/shots/d-activity.png';
import activity from '../assets/shots/activity.png';
import backlog from '../assets/shots/backlog.png';
import dStats from '../assets/shots/d-stats.png';
import overview from '../assets/shots/overview.png';
import login from '../assets/shots/login.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const icon = (no: number) => base + 'icons/' + no + '.png';
// Real badges from the author's recent unlocks, read from public/badges at build time
const badgeFiles = fs.readdirSync(path.join(process.cwd(), 'public/badges')).filter(f => f.endsWith('.png')).sort().map(f => base + 'badges/' + f);
const rows = [0, 1, 2].map(r => badgeFiles.filter((_, k) => k % 3 === r));

// Real entries from the author's dex
const entries: Entry[] = [
    { no: 16244, title: 'Final Fantasy Crystal Chronicles: Ring of Fates', console: 'Nintendo DS', icon: icon(16244), got: 9, total: 76, state: 'played', path: [7, 22] },
    { no: 11306, title: 'Tomba! 2: The Evil Swine Return', console: 'PlayStation', icon: icon(11306), got: 30, total: 45, state: 'beaten' },
    { no: 2873, title: "Donald Duck: Goin' Quackers", console: 'PlayStation', icon: icon(2873), got: 46, total: 65, state: 'beaten' },
    { no: 16452, title: '7th Dragon 2020', console: 'PlayStation Portable', icon: icon(16452), got: 80, total: 80, state: 'mastered' },
];

const web = async (img: ImageMetadata, width: number) => (await getImage({ src: img, width, format: 'webp' })).src;
const parts: Part[] = [
    { id: 'dex', name: 'The Dex', holds: 'every game, numbered', text: 'Every game you have played, numbered by its RetroAchievements ID. Filter to unbeaten, beaten or mastered, or read it console by console.',
      desk: { src: await web(dDex, 1440), alt: 'The Dex on desktop: game entries in number order beside the profile rail' }, phone: { src: await web(dex, 390), alt: 'The Dex on a phone' } },
    { id: 'record', name: 'Dex records', holds: 'one page per game', text: 'Each game opens as its dex record: the completion ring, achievements and points as index lines, and the progression path.',
      desk: { src: await web(dGame, 1440), alt: 'A game page on desktop with its dex record and achievement list' }, phone: { src: await web(game, 390), alt: 'A game page on a phone' } },
    { id: 'activity', name: 'Activity', holds: 'runs, day by day', text: 'The dexes that moved in the last fortnight, then every run of unlocks, day by day, with a year of streaks and a heatmap.',
      desk: { src: await web(dActivity, 1440), alt: 'Activity on desktop: the dexes that moved, the year and recent runs' }, phone: { src: await web(activity, 390), alt: 'Activity on a phone' } },
    { id: 'backlog', name: 'Backlog', holds: 'your want-to-play list', text: 'Your RetroAchievements want-to-play list as a watchlist, subsets stacked under their game, progress as rings.',
      phone: { src: await web(backlog, 390), alt: 'The backlog watchlist on a phone' } },
    { id: 'stats', name: 'Stats', holds: 'a year in charts', text: 'Streaks and pace as index lines, points across the year, masteries by month, consoles and how rare your unlocks are.',
      desk: { src: await web(dStats, 1440), alt: 'Stats on desktop: streaks, point acquisition, masteries, consoles and rarity' } },
    { id: 'overview', name: 'Overview', holds: 'the profile at a glance', text: 'Last played, recent unlocks, your stats and every award, with the latest mastery on top.',
      phone: { src: await web(overview, 390), alt: 'The profile overview on a phone' } },
];

const description = 'Cheevodex is a free, open-source companion for RetroAchievements: every game you have played as a numbered dex entry, with completion rings, activity, friends and your backlog. Runs in your browser; your API key never leaves it.';
const jsonLd = [{
    '@type': 'WebApplication',
    name: 'Cheevodex',
    description,
    applicationCategory: 'GameApplication',
    applicationSubCategory: 'Achievement tracker',
    operatingSystem: 'Web, Android, iOS (installable web app)',
    browserRequirements: 'Requires JavaScript',
    url: APP,
    image: new URL(base + 'assets/og.jpg', Astro.site).href,
    screenshot: new URL(await web(dDex, 1440), Astro.site).href,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    license: 'https://opensource.org/licenses/MIT',
    isAccessibleForFree: true,
    sameAs: [REPO],
    featureList: ['Every played game as a numbered dex entry', 'Completion rings and progression paths', 'Activity with streaks and a heatmap', 'Friends timeline', 'Backlog watchlist', 'Installs as a phone app'],
}];
---
<Base title="Cheevodex: a pocket companion for RetroAchievements" {description} {jsonLd}>
<main id="main">
    <!-- Hero: the copy, then a dex entry writing itself over a slow wall of real badges -->
    <section class="hero">
        <div class="badgewall" aria-hidden="true">
            {rows.map((r, k) => (
                <div class={`brow brow-${k}`}>
                    {[...r, ...r].map(b => <img src={b} alt="" width="48" height="48" loading="lazy" />)}
                </div>
            ))}
        </div>
        <div class="wrap hero-grid">
            <div class="hero-copy">
                <h1>Every unlock, in your own dex.</h1>
                <p class="lede">Cheevodex turns your RetroAchievements account into a dex: every game you have played, numbered, ringed and ready on your phone.</p>
                <div class="cta">
                    <a class="btn btn-primary" href={APP}>Open Cheevodex</a>
                    <a class="btn btn-ghost" href="#connect">How to connect</a>
                </div>
                <ul class="facts">
                    <li>Free and open source</li>
                    <li>Runs in your browser</li>
                    <li>No sign-up beyond your RA account</li>
                </ul>
            </div>
            <div class="hero-stage">
                <Image class="hero-shot" src={dDex} alt="The Dex on desktop: every played game as a numbered entry" widths={[800, 1200, 1600]} sizes="(max-width: 960px) 92vw, 620px" loading="eager" fetchpriority="high" />
                <HeroDex client:visible entries={entries} />
            </div>
        </div>
    </section>

    <!-- The Dex -->
    <section class="section" id="dex">
        <div class="wrap split">
            <div class="split-copy reveal">
                <h2>Your games, numbered like a codex.</h2>
                <p>Every game you have touched on RetroAchievements gets an entry and a dex number, its RA game ID. Search by name or number, filter to what you have not beaten yet, or read it console by console.</p>
                <dl class="dexcount">
                    <div><dt>Played</dt><dd class="t-accent">96</dd></div>
                    <div><dt>Beaten</dt><dd class="t-silver">8</dd></div>
                    <div><dt>Mastered</dt><dd class="t-gold">2</dd></div>
                </dl>
                <p class="caption">The author's dex, as Cheevodex shows it.</p>
            </div>
            <div class="split-shot reveal">
                <Image class="shot phone-shot" src={dex} alt="The Dex on a phone: numbered entries with their icons, counts and state" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 340px" />
            </div>
        </div>
    </section>

    <!-- A dex record, built live -->
    <section class="section band" id="record">
        <div class="wrap">
            <div class="section-head reveal">
                <h2>Each game opens as a dex record.</h2>
                <p>The completion ring, the numbers as index lines, and a path that lights one diamond for every progression achievement you have unlocked.</p>
            </div>
            <div class="record-stage reveal">
                <DexRecord client:visible icon={icon(16244)} />
                <Image class="shot phone-shot" src={game} alt="The same game in Cheevodex on a phone: its dex record above the achievement list" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 340px" />
            </div>
        </div>
    </section>

    <!-- The dexes that moved -->
    <section class="section" id="moved">
        <div class="wrap split flip">
            <div class="split-copy reveal">
                <h2>See which dexes moved this fortnight.</h2>
                <p>Activity opens on the games you progressed in the last 14 days: what you had before in a dim ring, what you gained in a bright one. Below, every run of unlocks, day by day.</p>
                <p>Switch to Friends for the people you follow, on one timeline, each in their own colour.</p>
            </div>
            <div class="split-shot reveal">
                <Image class="shot phone-shot" src={activity} alt="Activity on a phone: the dexes that moved, then today's runs" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 340px" />
            </div>
        </div>
    </section>

    <!-- Contents -->
    <section class="section band" id="contents">
        <div class="wrap">
            <div class="section-head reveal">
                <h2>The contents of your codex.</h2>
                <p>Six parts, one tap apart. Pick a line to turn to it.</p>
            </div>
            <div class="reveal"><Contents client:visible parts={parts} /></div>
        </div>
    </section>

    <!-- Privacy -->
    <section class="section" id="private">
        <div class="wrap private">
            <div class="reveal">
                <h2>Your key never leaves your browser.</h2>
                <p>Cheevodex has no server and no account of its own. It asks RetroAchievements directly from your browser with your web API key, which stays on your device.</p>
            </div>
            <figure class="flow reveal" aria-label="How a request travels: your browser talks to the RetroAchievements API directly">
                <div class="node"><b>Your browser</b><span>Cheevodex, with your key saved on this device</span></div>
                <div class="wire"><span>direct, over HTTPS</span></div>
                <div class="node"><b>RetroAchievements</b><span>its public web API</span></div>
                <figcaption>No server in between. The source is on <a href={REPO}>GitHub</a> to check.</figcaption>
            </figure>
        </div>
    </section>

    <!-- Connect -->
    <section class="section band" id="connect">
        <div class="wrap split">
            <div class="split-copy reveal">
                <h2>Connect in a minute.</h2>
                <ol class="steps">
                    <li><span>Log in at <a href={RA}>retroachievements.org</a>.</span></li>
                    <li><span>Open <a href={RA_KEYS}>Settings</a>, then Keys, and copy your web API key.</span></li>
                    <li><span>Open Cheevodex and enter your username and the key.</span></li>
                </ol>
                <div class="cta">
                    <a class="btn btn-primary" href={APP}>Open Cheevodex</a>
                </div>
                <p class="caption">Install it from your browser's menu and it opens full screen, like an app.</p>
            </div>
            <div class="split-shot reveal">
                <Image class="shot phone-shot" src={login} alt="The Cheevodex sign-in: RA username, API key and the steps to find your key" widths={[390, 780]} sizes="(max-width: 960px) 70vw, 340px" />
            </div>
        </div>
    </section>
</main>
</Base>
