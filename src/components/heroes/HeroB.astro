---
// Hero B, Try it: the turning tagline over a small working dex in an app frame
import HeroDemo from '../HeroDemo';
import Tagline from '../Tagline';
import { entries } from './entries';
import { APP } from '../../lib/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="hero hv-b">
    <div class="wrap">
        <div class="hero-head">
            <Tagline client:load />
            <p class="lede">Cheevodex turns your RetroAchievements account into a dex: every game you have played, numbered, ringed and ready on your phone.</p>
            <div class="cta">
                <a class="btn btn-primary" href={APP}>Open Cheevodex</a>
                <a class="btn btn-ghost" href="#setup">How to connect</a>
            </div>
        </div>
        <HeroDemo client:visible entries={entries} mark={base + 'assets/favicon.svg'} />
        <p class="hv-b-note">New to <a href="https://retroachievements.org">RetroAchievements</a>? It is a free community that adds achievements to classic games played on emulators. Cheevodex reads your account there.</p>
    </div>
</section>
