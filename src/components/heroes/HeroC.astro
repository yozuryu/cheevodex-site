---
// Hero C, Centre stage: the headline split around one upright phone whose screens turn over
import { getImage } from 'astro:assets';
import PhoneCycle from '../PhoneCycle';
import Tagline from '../Tagline';
import { APP } from '../../lib/site';
import game from '../../assets/shots/game.png';
import dex from '../../assets/shots/dex.png';
import activity from '../../assets/shots/activity.png';
const web = async (img: ImageMetadata) => (await getImage({ src: img, width: 660, format: 'webp' })).src;
const screens = [
    { src: await web(game), alt: "A game's dex record in Cheevodex: ring, index lines and progression path", name: 'Record' },
    { src: await web(dex), alt: 'The Dex in Cheevodex: numbered entries with counts and state', name: 'Dex' },
    { src: await web(activity), alt: "Activity in Cheevodex: the dexes that moved, then the day's runs", name: 'Activity' },
];
---
<section class="hero hv-c">
    <div class="wrap">
        <div class="hv-c-stage">
            <Tagline client:load split />
            <PhoneCycle client:visible screens={screens} />
        </div>
        <div class="hv-c-foot">
            <p class="lede">Cheevodex turns your RetroAchievements account into a dex: every game you have played, numbered, ringed and ready on your phone.</p>
            <div class="cta">
                <a class="btn btn-primary" href={APP}>Open Cheevodex</a>
                <a class="btn btn-ghost" href="#setup">How to connect</a>
            </div>
        </div>
    </div>
</section>
